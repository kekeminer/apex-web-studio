---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import PaymentModal from '../../components/ui/PaymentModal.astro';
import {
  ArrowLeft,
  HelpCircle,
  ArrowRight,
  Check,
  CreditCard,
  Search,
  Sparkles,
  TrendingUp,
  Layers,
  Cpu,
  ShieldCheck,
  CheckCircle2,
} from 'lucide-astro';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

interface Props {
  service: CollectionEntry<'servicios'>;
}

const { service } = Astro.props;
const { Content } = await render(service);
const { title, description, planes, process, faq } = service.data;

const allServices = await getCollection('servicios');
const otherServices = allServices
  .filter((s) => s.id !== service.id)
  .slice(0, 4);

const planList = [
  { key: 'basico', name: 'Básico', data: planes.basico },
  { key: 'pro', name: 'Pro', data: planes.pro, recomendado: true },
  { key: 'business', name: 'Business', data: planes.business },
];

// Rich technical metadata per service
const serviceMetadata: Record<
  string,
  {
    roi: string;
    roiDesc: string;
    stack: string[];
    entregables: string[];
  }
> = {
  'desarrollo-de-landing-page': {
    roi: '+45% en Conversión',
    roiDesc: 'Optimizada para transformar visitantes en leads calificados mediante embudos sin fricción.',
    stack: ['Astro 5', 'Tailwind CSS v4', 'TypeScript', 'GSAP', 'Vercel Edge'],
    entregables: [
      'Landing page 100% responsive y accesible (WCAG 2.1 AA)',
      'Velocidad de carga extrema (LCP < 1.0s, Lighthouse 98+)',
      'Formulario de contacto con validación Zod y sanitización antispam',
      'Modo claro y modo oscuro nativos con persistencia',
      'Metadatos SEO, OpenGraph y Twitter Cards integrados',
    ],
  },
  'tiendas-ecommerce': {
    roi: '-35% Carrito Abandonado',
    roiDesc: 'Checkout en 2 pasos y tiempos de carga instantáneos para maximizar compras recurrentes.',
    stack: ['Astro / Next.js', 'TypeScript', 'Stripe API', 'Mercado Pago SDK', 'Supabase'],
    entregables: [
      'Catálogo interactivo de productos con filtros y variantes',
      'Flujo de carrito y checkout de mínima fricción',
      'Integración con pasarelas de pago (Mercado Pago, Stripe, PayPal)',
      'Panel de control intuitivo para gestión de catálogo e inventario',
      'Infraestructura en CDN capaz de soportar picos masivos de tráfico',
    ],
  },
  'aplicaciones-web': {
    roi: '3.5x en Productividad',
    roiDesc: 'Automatización de flujos operativos y centralización de datos empresariales en la nube.',
    stack: ['React / Astro', 'Node.js', 'PostgreSQL', 'Serverless', 'Docker'],
    entregables: [
      'Arquitectura de software modular orientada a microservicios',
      'Autenticación segura (OAuth 2.0 / JWT) y control de roles RBAC',
      'Base de datos estructurada con telemetría en tiempo real',
      'Código fuente 100% tipado con pruebas automatizadas',
      'Despliegue Serverless con escalabilidad automática',
    ],
  },
  'mantenimiento-y-soporte': {
    roi: '99.9% de Disponibilidad',
    roiDesc: 'Prevención proactiva de caídas, parches de seguridad y acompañamiento técnico continuo.',
    stack: ['Uptime Kuma', 'GitHub Actions', 'Cloud Backups', 'Vercel Monitoring'],
    entregables: [
      'Actualizaciones mensuales preventivas de librerías y dependencias',
      'Copias de seguridad redundantes automatizadas en la nube',
      'Monitoreo activo 24/7 con detección de anomalías y alertas',
      'Bolsa mensual de horas dedicadas a desarrollo evolutivo',
      'Soporte técnico prioritario con tiempos de respuesta garantizados',
    ],
  },
  'agentes-de-ia': {
    roi: '70% de Consultas Resueltas',
    roiDesc: 'Atención 24/7 con respuestas contextuales basadas en la documentación de tu empresa.',
    stack: ['Python / TypeScript', 'OpenAI / Anthropic', 'Vector DB', 'RAG'],
    entregables: [
      'Agente conversacional inteligente entrenado con tu base de conocimiento',
      'Integración nativa en tu sitio web o canal de WhatsApp',
      'Capacidad de ejecutar acciones en tiempo real (Function Calling)',
      'Guardrails estrictos de seguridad y privacidad corporativa',
      'Panel de registro de conversaciones y análisis de rendimiento',
    ],
  },
};

const meta = serviceMetadata[service.id] || {
  roi: '+40% Rendimiento',
  roiDesc: 'Solución optimizada para máxima velocidad y conversión comercial.',
  stack: ['Astro 5', 'TypeScript', 'Tailwind CSS v4'],
  entregables: ['Código tipado', 'Diseño responsive', 'SEO técnico base'],
};

// FAQ Schema for this service
const serviceFaqJsonLd = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;
---

<Base title={`${title} | Apex Web Studio`} description={description}>
  {serviceFaqJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(serviceFaqJsonLd)} />
  )}

  <!-- Hero Section of Service -->
  <section class="relative py-16 md:py-24 border-b border-[var(--border-color)] overflow-hidden bg-[var(--bg)]">
    <!-- Ambient subtle electric blue glow -->
    <div class="absolute -top-20 right-10 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left relative z-10">
      <a
        href="/servicios"
        class="inline-flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] hover:text-blue-500 transition-colors mb-8 group"
      >
        <ArrowLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
        <span>Volver a todos los servicios</span>
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-500 font-mono text-xs font-semibold mb-4">
            <Sparkles class="w-3.5 h-3.5" />
            <span>Servicio Especializado High-End</span>
          </div>

          <h1 class="font-heading font-extrabold text-3xl sm:text-5xl lg:text-6xl text-[var(--text)] tracking-tight mb-6 leading-tight">
            {title}
          </h1>

          <p class="text-base sm:text-xl text-[var(--text-muted)] leading-relaxed mb-8">
            {description}
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <Button href="#planes" variant="primary" size="lg" class="shadow-md">
              <span>Ver Planes y Tarifas</span>
              <ArrowRight class="w-5 h-5" />
            </Button>
            <a
              href="#metodologia"
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl border border-[var(--border-color)] hover:border-blue-500/40 text-xs font-heading font-semibold text-[var(--text)] transition-colors"
            >
              <span>Ver Metodología en 3 Pasos</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Expected ROI Card -->
        <div class="lg:col-span-4 w-full">
          <div class="p-6 sm:p-8 rounded-3xl border border-blue-500/30 bg-[var(--card-bg)] shadow-[0_0_40px_-15px_rgba(59,130,246,0.25)] relative overflow-hidden">
            <div class="w-12 h-12 rounded-2xl bg-blue-500/15 border border-blue-500/30 flex items-center justify-center text-blue-500 mb-4">
              <TrendingUp class="w-6 h-6" />
            </div>
            <span class="text-xs font-mono uppercase tracking-widest text-blue-500 block mb-1">
              Retorno de Inversión Estimado
            </span>
            <h3 class="font-heading font-extrabold text-3xl sm:text-4xl text-[var(--text)] mb-3">
              {meta.roi}
            </h3>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-6 font-mono">
              {meta.roiDesc}
            </p>
            <div class="pt-4 border-t border-[var(--border-color)] flex items-center gap-2 text-xs font-mono text-[var(--text)]">
              <ShieldCheck class="w-4 h-4 text-blue-500 flex-shrink-0" />
              <span>Garantía de código estricto y WCAG 2.1 AA</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Deliverables & Tech Stack Section -->
  <section class="py-16 border-b border-[var(--border-color)] bg-[var(--bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Tangible Deliverables -->
        <div class="p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)]">
          <h3 class="font-heading font-bold text-xl text-[var(--text)] mb-6 flex items-center gap-2.5">
            <Layers class="w-5 h-5 text-blue-500" />
            <span>Entregables Concretos del Proyecto</span>
          </h3>
          <ul class="space-y-3.5">
            {
              meta.entregables.map((item) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-[var(--text)] font-mono">
                  <CheckCircle2 class="w-4 h-4 text-blue-500 flex-shrink-0 mt-0.5" />
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Tech Stack -->
        <div class="p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] flex flex-col justify-between">
          <div>
            <h3 class="font-heading font-bold text-xl text-[var(--text)] mb-6 flex items-center gap-2.5">
              <Cpu class="w-5 h-5 text-blue-500" />
              <span>Pila Tecnológica Asociada</span>
            </h3>
            <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed mb-6">
              Desarrollamos con tecnologías modernas de última generación para evitar frameworks pesados, asegurar tiempos de respuesta instantáneos y cero deuda técnica.
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {
                meta.stack.map((tech) => (
                  <span class="px-3 py-1.5 rounded-xl border border-blue-500/25 bg-blue-500/10 text-xs font-mono font-medium text-[var(--text)]">
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>

          <div class="p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--badge-bg)] text-xs font-mono text-[var(--text-muted)]">
            💡 Todo el código fuente pasa por linters estrictos, TypeScript en modo estricto y auditorías automáticas de Core Web Vitals.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Plans Section -->
  <section id="planes" class="py-20 border-b border-[var(--border-color)] bg-[var(--bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <div class="max-w-3xl mb-12">
        <Badge class="mb-4">Tarifas Claras & Transparentes</Badge>
        <h2 class="font-heading font-bold text-3xl sm:text-5xl text-[var(--text)] tracking-tight mb-4">
          Planes Adaptados a tus Metas
        </h2>
        <p class="text-base text-[var(--text-muted)] leading-relaxed">
          Precios cerrados y sin costos ocultos. Todos los planes incluyen código tipado, arquitectura de alto rendimiento y accesibilidad WCAG 2.1 AA.
        </p>
      </div>

      <!-- 3 Plans Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        {
          planList.map((plan) => (
            <div
              class={`rounded-3xl flex flex-col justify-between relative p-8 transition-all duration-300 ${
                plan.recomendado
                  ? 'border-2 border-blue-500 bg-[var(--card-hover-bg)] shadow-[0_0_50px_-15px_rgba(59,130,246,0.3)] scale-[1.02]'
                  : 'border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-blue-500/30'
              }`}
            >
              <div>
                <div class="flex items-center justify-between gap-3 mb-3">
                  <h3 class="font-heading font-bold text-2xl text-[var(--text)]">
                    {plan.name}
                  </h3>
                  {plan.recomendado && (
                    <span class="inline-block bg-blue-600 text-white font-mono text-[10px] font-bold uppercase tracking-wider py-1 px-3 rounded-full shadow-sm flex-shrink-0">
                      Recomendado
                    </span>
                  )}
                </div>

                <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-6 min-h-[36px]">
                  {plan.data.descripcion}
                </p>

                <div class="mb-6 pb-6 border-b border-[var(--border-color)]">
                  <span class="font-heading font-extrabold text-3xl sm:text-4xl text-[var(--text)]">
                    {plan.data.precio}
                  </span>
                </div>

                <h4 class="font-heading font-semibold text-xs tracking-wider uppercase text-[var(--text)] mb-4">
                  Qué incluye:
                </h4>

                <ul class="space-y-3 mb-8">
                  {plan.data.incluye.map((item) => (
                    <li class="flex items-start gap-2.5 text-xs font-mono text-[var(--text)]">
                      <Check class="w-4 h-4 text-blue-500 flex-shrink-0 mt-0.5" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Button "Pagar este plan" (Opens Rectangular Modal In-Situ) -->
              <button
                type="button"
                class={`btn-pay-plan w-full py-3.5 px-6 rounded-xl font-heading font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all cursor-pointer ${
                  plan.recomendado
                    ? 'bg-blue-600 hover:bg-blue-500 text-white shadow-[0_0_25px_rgba(59,130,246,0.35)] hover:scale-[1.02] active:scale-[0.98]'
                    : 'border border-[var(--border-color)] hover:border-blue-500/50 bg-[var(--bg)] text-[var(--text)] hover:bg-[var(--card-hover-bg)]'
                }`}
                data-service-title={title}
                data-plan-name={plan.name}
                data-plan-price={plan.data.precio}
              >
                <span>Pagar este plan</span>
                <ArrowRight class="w-4 h-4" />
              </button>
            </div>
          ))
        }
      </div>

      <!-- Omnichannel SEO / AEO / GEO Note -->
      {
        service.id !== 'mantenimiento-y-soporte' && (
          <div class="mb-6 p-6 rounded-2xl border border-blue-500/30 bg-[var(--card-bg)] flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <div class="w-10 h-10 rounded-xl border border-blue-500/30 bg-blue-500/10 flex items-center justify-center text-blue-500 flex-shrink-0">
              <Search class="w-5 h-5" />
            </div>
            <p class="text-sm font-medium text-[var(--text)] leading-relaxed">
              <strong>Optimización Omnicanal Incluida:</strong> Este proyecto incluye optimización de <strong>SEO</strong> (buscadores tradicionales), <strong>AEO</strong> (respuestas directas y voz) y <strong>GEO</strong> (motores de inteligencia artificial como ChatGPT, Perplexity y AI Overviews).
            </p>
          </div>
        )
      }

      <!-- 40-30-30 Transparent Payment Callout -->
      <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-10 h-10 rounded-xl border border-[var(--border-color)] bg-[var(--badge-bg)] flex items-center justify-center text-blue-500 flex-shrink-0">
          <CreditCard class="w-5 h-5" />
        </div>
        <p class="text-sm font-medium text-[var(--text)] leading-relaxed">
          <strong>Esquema de pago 40-30-30:</strong> 40% al iniciar el proyecto, 30% al entregar el diseño y la funcionalidad para revisión, y 30% al publicar tu sitio en la web.
        </p>
      </div>
    </div>
  </section>

  <!-- 3-Step Methodology Section -->
  <section id="metodologia" class="py-20 border-b border-[var(--border-color)] bg-[var(--bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <div class="max-w-3xl mb-12">
        <Badge class="mb-4">Proceso en 3 Pasos</Badge>
        <h2 class="font-heading font-bold text-3xl sm:text-4xl text-[var(--text)] tracking-tight mb-4">
          Metodología de Trabajo Rigurosa
        </h2>
        <p class="text-base text-[var(--text-muted)] leading-relaxed">
          Un flujo ágil y predecible estructurado para minimizar tiempos de entrega y garantizar calidad técnica.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          process.slice(0, 3).map((step, idx) => (
            <div class="p-6 sm:p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] flex flex-col justify-between hover:border-blue-500/30 transition-colors">
              <div>
                <span class="font-mono font-extrabold text-2xl text-blue-500 block mb-3">
                  0{idx + 1}
                </span>
                <h3 class="font-heading font-bold text-lg text-[var(--text)] mb-2">
                  {step.title}
                </h3>
                <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed font-mono">
                  {step.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Detailed MDX Content & FAQ Section -->
  <section class="py-20 bg-[var(--bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 text-left">
        <!-- Main Column: MDX & FAQ -->
        <div class="lg:col-span-2 space-y-16">
          <div class="prose dark:prose-invert max-w-none text-[var(--text)] leading-relaxed font-sans text-base">
            <Content />
          </div>

          <!-- FAQ Section -->
          {
            faq && faq.length > 0 && (
              <div>
                <h2 class="font-heading font-bold text-2xl sm:text-3xl text-[var(--text)] mb-8 flex items-center gap-3">
                  <HelpCircle class="w-7 h-7 text-blue-500" />
                  <span>Preguntas Frecuentes</span>
                </h2>
                <div class="space-y-4">
                  {faq.map((item) => (
                    <Card hover={false} class="p-6">
                      <h3 class="font-heading font-semibold text-base text-[var(--text)] mb-2">
                        {item.question}
                      </h3>
                      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
                        {item.answer}
                      </p>
                    </Card>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        <!-- Sidebar Column: Other Services -->
        <div class="space-y-8">
          <div class="p-6 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)]">
            <h3 class="font-heading font-bold text-base text-[var(--text)] mb-4">
              Otros Servicios Especializados
            </h3>
            <ul class="space-y-3">
              {
                otherServices.map((other) => (
                  <li>
                    <a
                      href={`/servicios/${other.id}`}
                      class="text-sm text-[var(--text-muted)] hover:text-blue-500 transition-colors flex items-center justify-between group py-1"
                    >
                      <span>{other.data.title}</span>
                      <ArrowRight class="w-4 h-4 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-blue-500" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reusable Accessible Payment Modal -->
  <PaymentModal />
</Base>

<script>
  interface WindowWithPaymentModal extends Window {
    openPaymentModal?: (serviceTitle: string, planName: string, price?: string, target?: HTMLElement) => void;
  }

  function setupPlanPayButtons() {
    const payButtons = document.querySelectorAll('.btn-pay-plan');
    payButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const serviceTitle = target.getAttribute('data-service-title') || '';
        const planName = target.getAttribute('data-plan-name') || '';
        const planPrice = target.getAttribute('data-plan-price') || '';

        const win = window as WindowWithPaymentModal;
        if (typeof win.openPaymentModal === 'function') {
          win.openPaymentModal(serviceTitle, planName, planPrice, target);
        }
      });
    });
  }

  setupPlanPayButtons();
  document.addEventListener('astro:after-swap', setupPlanPayButtons);
</script>
