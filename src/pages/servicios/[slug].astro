---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import PaymentModal from '../../components/ui/PaymentModal.astro';
import { ArrowLeft, HelpCircle, ArrowRight, Check, CreditCard, Search } from 'lucide-astro';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

interface Props {
  service: CollectionEntry<'servicios'>;
}

const { service } = Astro.props;
const { Content } = await render(service);
const { title, description, planes, process, faq } = service.data;

const allServices = await getCollection('servicios');
const otherServices = allServices
  .filter((s) => s.id !== service.id)
  .slice(0, 4);

const planList = [
  { key: 'basico', name: 'Básico', data: planes.basico },
  { key: 'pro', name: 'Pro', data: planes.pro, recomendado: true },
  { key: 'business', name: 'Business', data: planes.business },
];
---

<Base title={`${title} | Apex Web Studio`} description={description}>
  <!-- Hero Section of Service (Left aligned) -->
  <section class="py-16 md:py-24 border-b border-[var(--border-color)] bg-[var(--bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <a
        href="/#servicios"
        class="inline-flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text)] transition-colors mb-8"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Volver a todos los servicios</span>
      </a>

      <div class="max-w-3xl">
        <Badge class="mb-4">Servicio Especializado</Badge>
        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl text-[var(--text)] tracking-tight mb-6">
          {title}
        </h1>
        <p class="text-lg sm:text-xl text-[var(--text-muted)] leading-relaxed mb-8">
          {description}
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <Button href="#planes" variant="primary" size="lg">
            <span>Ver Planes y Precios</span>
            <ArrowRight class="w-5 h-5" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Plans Section -->
  <section id="planes" class="py-20 border-b border-[var(--border-color)] bg-[var(--bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <div class="max-w-3xl mb-12">
        <Badge class="mb-4">Planes & Tarifas</Badge>
        <h2 class="font-heading font-bold text-3xl sm:text-4xl text-[var(--text)] tracking-tight mb-4">
          Planes Adaptados a Cada Etapa
        </h2>
        <p class="text-base text-[var(--text-muted)] leading-relaxed">
          Selecciona la modalidad que mejor responda a las metas de tu empresa. Todos los desarrollos incluyen código tipado, rendimiento extremo y WCAG 2.1 AA.
        </p>
      </div>

      <!-- 3 Plans Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        {
          planList.map((plan) => (
            <Card
              hover={false}
              class={`flex flex-col justify-between relative p-8 ${
                plan.recomendado
                  ? 'border-2 border-[var(--text)] shadow-xl bg-[var(--card-hover-bg)]'
                  : 'border border-[var(--border-color)] bg-[var(--card-bg)]'
              }`}
            >
              <div>
                {plan.recomendado && (
                  <div class="absolute -top-3.5 right-6">
                    <Badge class="bg-[var(--text)] text-[var(--bg)] font-mono text-[10px] uppercase py-0.5 px-3">
                      Recomendado
                    </Badge>
                  </div>
                )}

                <h3 class="font-heading font-bold text-2xl text-[var(--text)] mb-2">
                  {plan.name}
                </h3>
                <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-6 min-h-[36px]">
                  {plan.data.descripcion}
                </p>

                <div class="mb-6 pb-6 border-b border-[var(--border-color)]">
                  <span class="font-heading font-extrabold text-3xl sm:text-4xl text-[var(--text)]">
                    {plan.data.precio}
                  </span>
                </div>

                <h4 class="font-heading font-semibold text-xs tracking-wider uppercase text-[var(--text)] mb-4">
                  Qué incluye:
                </h4>
                <ul class="space-y-3 mb-8">
                  {plan.data.incluye.map((item) => (
                    <li class="flex items-start gap-2.5 text-xs font-mono text-[var(--text)]">
                      <Check class="w-4 h-4 opacity-80 text-[var(--text)] flex-shrink-0 mt-0.5" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Button "Pagar este plan" -->
              <Button
                type="button"
                variant={plan.recomendado ? 'primary' : 'outline'}
                size="md"
                class="w-full btn-pay-plan"
                data-service-title={title}
                data-plan-name={plan.name}
              >
                <span>Pagar este plan</span>
                <ArrowRight class="w-4 h-4" />
              </Button>
            </Card>
          ))
        }
      </div>

      <!-- SEO, AEO & GEO Note (Shown on all services EXCEPT Mantenimiento y Soporte) -->
      {
        service.id !== 'mantenimiento-y-soporte' && (
          <div class="mb-6 p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <div class="w-10 h-10 rounded-xl border border-[var(--border-color)] bg-[var(--badge-bg)] flex items-center justify-center text-[var(--text)] flex-shrink-0">
              <Search class="w-5 h-5" />
            </div>
            <p class="text-sm font-medium text-[var(--text)] leading-relaxed">
              <strong>Optimización Omnicanal Incluida:</strong> Este proyecto incluye optimización de <strong>SEO</strong> (buscadores clásicos), <strong>AEO</strong> (respuestas directas y voz) y <strong>GEO</strong> (motores de inteligencia artificial como ChatGPT, Perplexity y AI Overviews).
            </p>
          </div>
        )
      }

      <!-- Highlighted 40-30-30 Payment Scheme Callout -->
      <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-10 h-10 rounded-xl border border-[var(--border-color)] bg-[var(--badge-bg)] flex items-center justify-center text-[var(--text)] flex-shrink-0">
          <CreditCard class="w-5 h-5" />
        </div>
        <p class="text-sm font-medium text-[var(--text)] leading-relaxed">
          <strong>Esquema de pago 40-30-30:</strong> 40% al iniciar el proyecto, 30% al entregar el diseño y la funcionalidad, y 30% al publicar el sitio en la web.
        </p>
      </div>
    </div>
  </section>

  <!-- Detailed Content & Process Section -->
  <section class="py-20 bg-[var(--bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 text-left">
        <!-- Main Column: Body MDX Content & Process -->
        <div class="lg:col-span-2 space-y-16">
          <!-- MDX Rendered Content -->
          <div class="prose dark:prose-invert max-w-none text-[var(--text)] leading-relaxed font-sans text-base">
            <Content />
          </div>

          <!-- Process / Methodology -->
          <div>
            <h2 class="font-heading font-bold text-2xl sm:text-3xl text-[var(--text)] mb-8">
              Metodología de Trabajo
            </h2>
            <div class="space-y-6">
              {
                process.map((step) => (
                  <Card hover={false} class="flex flex-col sm:flex-row gap-6 items-start">
                    <span class="font-mono font-bold text-2xl text-[var(--text)] opacity-40 px-3 py-1 border border-[var(--border-color)] rounded-lg bg-[var(--badge-bg)]">
                      {step.step}
                    </span>
                    <div>
                      <h3 class="font-heading font-bold text-lg text-[var(--text)] mb-2">
                        {step.title}
                      </h3>
                      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
                        {step.description}
                      </p>
                    </div>
                  </Card>
                ))
              }
            </div>
          </div>

          <!-- FAQ Section -->
          {
            faq && faq.length > 0 && (
              <div>
                <h2 class="font-heading font-bold text-2xl sm:text-3xl text-[var(--text)] mb-8 flex items-center gap-3">
                  <HelpCircle class="w-7 h-7" />
                  <span>Preguntas Frecuentes</span>
                </h2>
                <div class="space-y-4">
                  {faq.map((item) => (
                    <Card hover={false}>
                      <h3 class="font-heading font-semibold text-base text-[var(--text)] mb-2">
                        {item.question}
                      </h3>
                      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
                        {item.answer}
                      </p>
                    </Card>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        <!-- Sidebar Column: Other Services -->
        <div class="space-y-8">
          <Card hover={false}>
            <h3 class="font-heading font-bold text-base text-[var(--text)] mb-4">
              Otros Servicios
            </h3>
            <ul class="space-y-3">
              {
                otherServices.map((other) => (
                  <li>
                    <a
                      href={`/servicios/${other.id}`}
                      class="text-sm text-[var(--text-muted)] hover:text-[var(--text)] transition-colors flex items-center justify-between group"
                    >
                      <span>{other.data.title}</span>
                      <ArrowRight class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- Reusable Accessible Payment Modal -->
  <PaymentModal />
</Base>

<script>
  interface WindowWithPaymentModal extends Window {
    openPaymentModal?: (serviceTitle: string, planName: string, target?: HTMLElement) => void;
  }

  function setupPlanPayButtons() {
    const payButtons = document.querySelectorAll('.btn-pay-plan');
    payButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const serviceTitle = target.getAttribute('data-service-title') || '';
        const planName = target.getAttribute('data-plan-name') || '';
        const win = window as WindowWithPaymentModal;
        if (typeof win.openPaymentModal === 'function') {
          win.openPaymentModal(serviceTitle, planName, target);
        }
      });
    });
  }

  setupPlanPayButtons();
  document.addEventListener('astro:after-swap', setupPlanPayButtons);
</script>
