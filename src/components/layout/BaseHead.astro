---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  type?: string;
}

const {
  title = 'Apex Web Studio | Desarrollo Web High-End & Software A Medida',
  description = 'Estudio de desarrollo web especializado en sitios ultrarrápidos con Astro 5, Tailwind CSS v4, animaciones GSAP y optimización de conversión.',
  image = '/logo.webp',
  canonicalURL = Astro.url,
  type = 'website',
} = Astro.props;

const siteName = 'Apex Web Studio';
const formattedTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// JSON-LD Organization & Website Schema
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteName,
  url: 'https://apexwebstudio.com',
  logo: 'https://apexwebstudio.com/logo.webp',
  image: 'https://apexwebstudio.com/logo.webp',
  description: description,
  email: 'wbtech.agency@gmail.com',
  sameAs: [
    'https://www.instagram.com/apex_studioweb/',
    'https://www.tiktok.com/@apex_studioweb',
  ],
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'ES',
  },
};

// Critical CSS inline para navbar y hero (primer render sin bloqueos)
const criticalCSS = `
  :root{--bg:#ffffff;--text:#0a1633;--text-muted:rgba(10,22,51,0.7);--text-subtle:rgba(10,22,51,0.5);--border-color:rgba(10,22,51,0.12);--card-bg:rgba(10,22,51,0.03);--card-hover-bg:rgba(10,22,51,0.06);--navbar-bg:rgba(255,255,255,0.85);--badge-bg:rgba(10,22,51,0.08);--btn-primary-bg:#0a1633;--btn-primary-text:#ffffff;--btn-secondary-bg:rgba(10,22,51,0.06);--btn-secondary-text:#0a1633}
  html.dark{--bg:#0a1633;--text:#ffffff;--text-muted:rgba(255,255,255,0.7);--text-subtle:rgba(255,255,255,0.12);--border-color:rgba(255,255,255,0.12);--card-bg:rgba(255,255,255,0.04);--card-hover-bg:rgba(255,255,255,0.08);--navbar-bg:rgba(10,22,51,0.85);--badge-bg:rgba(255,255,255,0.1);--btn-primary-bg:#ffffff;--btn-primary-text:#0a1633;--btn-secondary-bg:rgba(255,255,255,0.1);--btn-secondary-text:#ffffff}
  body{background-color:var(--bg);color:var(--text);overflow-x:hidden}
`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/logo.webp" />
<meta name="generator" content={Astro.generator} />

<!-- Critical CSS Inline (evita bloqueo de render en primer paint) -->
<style set:html={criticalCSS} is:inline></style>

<!-- Theme Color Double Meta for Light / Dark mode -->
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0A1633" media="(prefers-color-scheme: dark)" />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:site_name" content={siteName} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={formattedTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Anti-FOUC Theme Script (inline, sin bloqueo de red) -->
<script is:inline>
  (function () {
    const storedTheme = localStorage.getItem('theme');
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (storedTheme === 'dark' || (!storedTheme && systemDark)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  })();
</script>

<!-- Structured Data Schema -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
