---
import ThemeToggle from '../ui/ThemeToggle.astro';
import Button from '../ui/Button.astro';
import { Menu, X } from 'lucide-astro';

const navLinks = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#stack', label: 'Stack' },
  { href: '/#nosotros', label: 'Nosotros' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-300 pt-3 px-4 sm:px-6 lg:px-8"
>
  <!-- Floating Rounded Navbar Container -->
  <div class="max-w-7xl mx-auto h-16 sm:h-20 px-6 rounded-2xl border border-[var(--border-color)] bg-[var(--navbar-bg)] backdrop-blur-md shadow-lg flex items-center justify-between">
    <!-- Brand Logo with Rounded Corners -->
    <a
      href="/"
      class="flex items-center gap-3 group outline-none rounded-xl p-1.5 transition-all hover:bg-[var(--card-hover-bg)] focus:border-b-2 focus:border-[var(--text)]"
      aria-label="Apex Web Studio Inicio"
    >
      <img
          src="/logo.webp"
          alt="Apex Web Studio Logo"
          width="40"
          height="40"
          class="h-9 sm:h-10 w-auto object-contain rounded-xl transition-transform group-hover:scale-105"
          fetchpriority="high"
          decoding="sync"
        />
      <span class="font-heading font-bold text-lg sm:text-xl tracking-tight text-[var(--text)] hidden sm:inline-block">
        APEX <span class="font-light opacity-80 text-xs tracking-widest block">WEB STUDIO</span>
      </span>
    </a>

    <!-- Desktop Navigation (Underline/Bottom-border Focus & Hover) -->
    <nav class="hidden md:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text)] hover:border-b-2 hover:border-[var(--text)] focus:text-[var(--text)] focus:border-b-2 focus:border-[var(--text)] transition-all outline-none py-1 px-0.5"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Action Controls -->
    <div class="hidden md:flex items-center gap-4">
      <ThemeToggle />
      <Button href="/#contacto" variant="primary" size="sm" class="rounded-xl">
        Consulta gratuita
      </Button>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-3 md:hidden">
      <ThemeToggle />
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        class="p-2 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] text-[var(--text)] outline-none focus:border-b-2 focus:border-[var(--text)]"
      >
        <Menu id="icon-menu" class="w-5 h-5" />
        <X id="icon-close" class="w-5 h-5 hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-menu"
    class="hidden md:hidden max-w-7xl mx-auto mt-2 rounded-2xl border border-[var(--border-color)] bg-[var(--bg)] px-6 py-6 transition-all shadow-xl"
  >
    <nav class="flex flex-col gap-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link text-base font-medium text-[var(--text)] py-2 border-b border-[var(--border-color)] hover:border-[var(--text)] focus:border-[var(--text)] transition-colors opacity-90 outline-none"
          >
            {link.label}
          </a>
        ))
      }
      <div class="pt-4">
        <Button href="/#contacto" variant="primary" size="md" class="w-full rounded-xl">
          Consulta gratuita
        </Button>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupNavbar() {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    if (!btn || !menu || !iconMenu || !iconClose) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    const links = document.querySelectorAll('.mobile-nav-link');
    links.forEach((l) => {
      l.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  setupNavbar();
  document.addEventListener('astro:after-swap', setupNavbar);
</script>
