---
import { Instagram, ArrowUpRight, Mail } from 'lucide-astro';

const navLinks = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#stack', label: 'Stack' },
  { href: '/#nosotros', label: 'Nosotros' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#contacto', label: 'Contacto' },
];

const servicesLinks = [
  { href: '/servicios/desarrollo-de-landing-page', label: 'Desarrollo de Landing Page' },
  { href: '/servicios/tiendas-ecommerce', label: 'Tiendas E-commerce' },
  { href: '/servicios/aplicaciones-web', label: 'Aplicaciones Web Custom' },
  { href: '/servicios/mantenimiento-y-soporte', label: 'Mantenimiento & Soporte' },
  { href: '/servicios/agentes-de-ia', label: 'Agentes de IA & Cerebros Digitales' },
];
---

<footer class="border-t border-[var(--border-color)] bg-[var(--bg)] text-[var(--text)] transition-colors pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <!-- Col 1: Brand -->
      <div class="flex flex-col gap-4 text-left">
        <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="Apex Web Studio Inicio">
          <img src="/logo.png" alt="Apex Web Studio Logo" class="h-10 w-auto object-contain" />
          <span class="font-heading font-bold text-xl tracking-tight text-[var(--text)]">
            APEX <span class="font-light opacity-80 text-xs tracking-widest block">WEB STUDIO</span>
          </span>
        </a>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          Estudio de arquitectura y desarrollo web de alto rendimiento. Creamos experiencias digitales a medida libres de fricción.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/apex_studioweb/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Sigue a Apex Web Studio en Instagram"
            class="p-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:bg-[var(--card-hover-bg)] text-[var(--text)] transition-all duration-200 hover:scale-105"
          >
            <Instagram class="w-5 h-5" />
          </a>
          <!-- Official TikTok SVG -->
          <a
            href="https://www.tiktok.com/@apex_studioweb"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Sigue a Apex Web Studio en TikTok"
            class="p-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:bg-[var(--card-hover-bg)] text-[var(--text)] transition-all duration-200 hover:scale-105 flex items-center justify-center"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Servicios -->
      <div class="text-left">
        <h3 class="font-heading font-semibold text-sm tracking-wider uppercase mb-4 text-[var(--text)]">
          Servicios
        </h3>
        <ul class="flex flex-col gap-2.5">
          {
            servicesLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-[var(--text-muted)] hover:text-[var(--text)] transition-colors inline-flex items-center gap-1 group"
                >
                  <span>{item.label}</span>
                  <ArrowUpRight class="w-3.5 h-3.5 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Navegación -->
      <div class="text-left">
        <h3 class="font-heading font-semibold text-sm tracking-wider uppercase mb-4 text-[var(--text)]">
          Navegación
        </h3>
        <ul class="flex flex-col gap-2.5">
          {
            navLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Contacto Técnico -->
      <div class="text-left">
        <h3 class="font-heading font-semibold text-sm tracking-wider uppercase mb-4 text-[var(--text)]">
          Soporte Técnico
        </h3>
        <p class="text-sm text-[var(--text-muted)] mb-4 leading-relaxed">
          ¿Tienes un proyecto en mente o necesitas asistencia directa con tu plataforma?
        </p>
        <a
          href="mailto:wbtech.agency@gmail.com"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:bg-[var(--card-hover-bg)] text-sm font-medium text-[var(--text)] transition-all"
        >
          <Mail class="w-4 h-4" />
          <span>wbtech.agency@gmail.com</span>
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-[var(--border-color)] text-center text-xs text-[var(--text-subtle)]">
      <p>© 2026 Apex Web Studio. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
