---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span
  class={`inline-flex items-center px-3 py-1 text-xs font-mono tracking-wider uppercase rounded-full border border-[var(--border-color)] bg-[var(--badge-bg)] text-[var(--text)] ${className}`}
>
  <slot />
</span>
