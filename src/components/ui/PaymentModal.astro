---
import { CONFIG_PAGOS } from '../../config/pagos';
import { X, Copy, Check, MessageSquare, ShieldCheck, Landmark, Smartphone } from 'lucide-astro';
---

<!-- Accessible High-End Physical-Card Payment Modal -->
<div
  id="payment-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-plan-title"
  class="fixed inset-0 z-50 hidden flex items-center justify-center p-3 sm:p-4 bg-black/85 backdrop-blur-md transition-opacity duration-200"
>
  <!-- Physical Credential / Rectangular Card (~10cm x ~7cm proportion, 390px-420px max width) -->
  <div
    class="modal-window relative w-full max-w-[420px] bg-slate-900 text-white border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-2xl flex flex-col max-h-[92vh] overflow-hidden text-left animate-in fade-in zoom-in-95 duration-200"
  >
    <!-- Close Button (Top Right) -->
    <button
      id="close-modal-btn"
      type="button"
      aria-label="Cerrar ventana de pago"
      class="absolute top-4 right-4 z-10 p-2 rounded-xl border border-slate-700/60 bg-slate-800/80 hover:bg-slate-700 hover:border-slate-500 text-slate-300 hover:text-white transition-all focus:outline-none focus:ring-2 focus:ring-blue-400"
    >
      <X class="w-4 h-4" />
    </button>

    <!-- Header Section (Selected Service & Exact Price) -->
    <div class="relative pb-4 border-b border-slate-800 flex-shrink-0 pr-8">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-blue-500/15 border border-blue-500/30 text-blue-400 font-mono text-[10px] font-semibold tracking-wider uppercase">
          <ShieldCheck class="w-3 h-3" />
          <span>Pago Directo</span>
        </span>
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">
          Sin Comisión
        </span>
      </div>

      <h3 id="modal-service-title" class="font-heading font-bold text-lg sm:text-xl text-white tracking-tight leading-snug">
        Desarrollo Web
      </h3>

      <div class="flex items-baseline gap-2 mt-1.5">
        <span id="modal-plan-title" class="text-xs font-mono font-medium text-blue-400 tracking-wide">
          Plan Pro
        </span>
        <span class="text-slate-600 font-mono text-xs">•</span>
        <span id="modal-plan-price" class="font-heading font-extrabold text-xl text-white tracking-tight">
          USD 750
        </span>
      </div>
    </div>

    <!-- Scrollable Body for Details -->
    <div class="modal-body overflow-y-auto overscroll-contain pr-1 py-4 flex-1 space-y-4">
      <!-- Accepted Payment Badges (CBU/CVU & Mercado Pago only) -->
      <div>
        <span class="text-[10px] font-mono uppercase tracking-widest text-slate-400 block mb-2">
          Métodos Aceptados
        </span>
        <div class="grid grid-cols-2 gap-2">
          <div class="px-3 py-2 rounded-xl border border-slate-800 bg-slate-800/50 flex flex-col items-center justify-center text-center gap-1">
            <Landmark class="w-4 h-4 text-blue-400" />
            <span class="text-[11px] font-mono font-medium text-slate-200">Transferencia (CBU/CVU)</span>
          </div>
          <div class="px-3 py-2 rounded-xl border border-slate-800 bg-slate-800/50 flex flex-col items-center justify-center text-center gap-1">
            <Smartphone class="w-4 h-4 text-sky-400" />
            <span class="text-[11px] font-mono font-medium text-slate-200">Mercado Pago</span>
          </div>
        </div>
      </div>

      <!-- Bank Transfer Details with 1-Click Copy -->
      <div class="space-y-2.5">
        <span class="text-[10px] font-mono uppercase tracking-widest text-slate-400 block">
          Datos de Transferencia (Copia en 1-Clic)
        </span>

        <!-- Titular Field -->
        <div class="p-2.5 rounded-xl border border-slate-800 bg-slate-800/40 flex items-center justify-between gap-2">
          <div>
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Titular</span>
            <span class="font-heading font-semibold text-xs sm:text-sm text-slate-100">{CONFIG_PAGOS.titular}</span>
          </div>
          <button
            type="button"
            data-copy={CONFIG_PAGOS.titular}
            aria-label="Copiar titular"
            class="copy-btn px-2.5 py-1.5 rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 hover:border-slate-500 text-slate-300 hover:text-white transition-all flex items-center gap-1 text-[11px] font-mono"
          >
            <Copy class="w-3 h-3 icon-copy" />
            <Check class="w-3 h-3 icon-check hidden text-emerald-400" />
            <span class="copy-label">Copiar</span>
          </button>
        </div>

        <!-- CBU / CVU Field -->
        <div class="p-2.5 rounded-xl border border-slate-800 bg-slate-800/40 flex items-center justify-between gap-2">
          <div class="min-w-0 flex-1">
            <span class="text-[10px] font-mono text-blue-400 uppercase tracking-wider block">CBU / CVU (22 dígitos)</span>
            <span class="font-mono font-bold text-xs text-white tracking-wide block truncate">{CONFIG_PAGOS.cbu}</span>
          </div>
          <button
            type="button"
            data-copy={CONFIG_PAGOS.cbu}
            aria-label="Copiar CBU"
            class="copy-btn px-2.5 py-1.5 rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 hover:border-blue-400 text-slate-300 hover:text-white transition-all flex items-center gap-1 text-[11px] font-mono flex-shrink-0"
          >
            <Copy class="w-3 h-3 icon-copy" />
            <Check class="w-3 h-3 icon-check hidden text-emerald-400" />
            <span class="copy-label">Copiar</span>
          </button>
        </div>

        <!-- Alias Field -->
        <div class="p-2.5 rounded-xl border border-slate-800 bg-slate-800/40 flex items-center justify-between gap-2">
          <div>
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Alias Bancario</span>
            <span class="font-mono font-bold text-xs sm:text-sm text-slate-100">{CONFIG_PAGOS.alias}</span>
          </div>
          <button
            type="button"
            data-copy={CONFIG_PAGOS.alias}
            aria-label="Copiar alias"
            class="copy-btn px-2.5 py-1.5 rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 hover:border-slate-500 text-slate-300 hover:text-white transition-all flex items-center gap-1 text-[11px] font-mono"
          >
            <Copy class="w-3 h-3 icon-copy" />
            <Check class="w-3 h-3 icon-check hidden text-emerald-400" />
            <span class="copy-label">Copiar</span>
          </button>
        </div>

        <!-- CUIT / CUIL Field -->
        <div class="p-2.5 rounded-xl border border-slate-800 bg-slate-800/40 flex items-center justify-between gap-2">
          <div>
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Identificación Fiscal (CUIT)</span>
            <span class="font-mono text-xs text-slate-200">{CONFIG_PAGOS.cuit}</span>
          </div>
          <button
            type="button"
            data-copy={CONFIG_PAGOS.cuit}
            aria-label="Copiar CUIT"
            class="copy-btn px-2.5 py-1.5 rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 hover:border-slate-500 text-slate-300 hover:text-white transition-all flex items-center gap-1 text-[11px] font-mono"
          >
            <Copy class="w-3 h-3 icon-copy" />
            <Check class="w-3 h-3 icon-check hidden text-emerald-400" />
            <span class="copy-label">Copiar</span>
          </button>
        </div>
      </div>

      <!-- 40-30-30 Scheme Reminder -->
      <div class="p-2.5 rounded-xl border border-slate-800/80 bg-slate-950/60 text-[11px] font-mono text-slate-400 leading-relaxed">
        <p class="text-slate-300 font-semibold mb-0.5">Esquema transparente 40-30-30:</p>
        <p>40% para iniciar el desarrollo, 30% contra entrega de diseño/funcionalidad y 30% al desplegar en tu dominio.</p>
      </div>
    </div>

    <!-- CTA Footer: Send Confirmation by WhatsApp -->
    <div class="pt-3 border-t border-slate-800 flex-shrink-0">
      <a
        id="modal-whatsapp-btn"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-heading font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all hover:scale-[1.01] active:scale-[0.99]"
      >
        <MessageSquare class="w-4 h-4" />
        <span>Enviar Comprobante por WhatsApp</span>
      </a>
      <p class="text-[10px] font-mono text-center text-slate-400 mt-2">
        Validación inmediata de tu comprobante y alta de proyecto.
      </p>
    </div>
  </div>
</div>

<style>
  .modal-body::-webkit-scrollbar {
    width: 4px;
  }
  .modal-body::-webkit-scrollbar-track {
    background: transparent;
  }
  .modal-body::-webkit-scrollbar-thumb {
    background: rgba(59, 130, 246, 0.25);
    border-radius: 4px;
  }
</style>

<script>
  import { CONFIG_PAGOS } from '../../config/pagos';

  interface WindowWithPaymentModal extends Window {
    openPaymentModal?: (serviceTitle: string, planName: string, price?: string, triggerEl?: HTMLElement) => void;
    lenis?: { stop: () => void; start: () => void };
  }

  function setupPaymentModal() {
    const modal = document.getElementById('payment-modal');
    const closeBtn = document.getElementById('close-modal-btn');
    const modalServiceTitle = document.getElementById('modal-service-title');
    const modalPlanTitle = document.getElementById('modal-plan-title');
    const modalPlanPrice = document.getElementById('modal-plan-price');
    const whatsappBtn = document.getElementById('modal-whatsapp-btn') as HTMLAnchorElement | null;
    const copyButtons = document.querySelectorAll('.copy-btn');

    if (!modal || !closeBtn || !modalServiceTitle || !modalPlanTitle || !modalPlanPrice) return;

    let triggerElement: HTMLElement | null = null;

    // Global opener function attached to window
    (window as WindowWithPaymentModal).openPaymentModal = (
      serviceTitle: string,
      planName: string,
      price?: string,
      triggerEl?: HTMLElement
    ) => {
      triggerElement = triggerEl || null;

      modalServiceTitle.textContent = serviceTitle || 'Servicio Apex';
      modalPlanTitle.textContent = `Plan ${planName || 'Pro'}`;
      modalPlanPrice.textContent = price || 'Consultar';

      if (whatsappBtn) {
        const textMsg = `Hola Apex Web Studio, quiero confirmar el pago de ${serviceTitle} (${planName}${price ? ` - ${price}` : ''}). Adjunto el comprobante de transferencia.`;
        whatsappBtn.href = `https://wa.me/${CONFIG_PAGOS.whatsapp}?text=${encodeURIComponent(textMsg)}`;
      }

      const win = window as WindowWithPaymentModal;
      if (win.lenis && typeof win.lenis.stop === 'function') {
        win.lenis.stop();
      }

      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      document.documentElement.classList.add('overflow-hidden');
      closeBtn.focus();
    };

    function closeModal() {
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      document.documentElement.classList.remove('overflow-hidden');

      const win = window as WindowWithPaymentModal;
      if (win.lenis && typeof win.lenis.start === 'function') {
        win.lenis.start();
      }

      if (triggerElement) {
        triggerElement.focus();
      }
    }

    closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Handle 1-Click Copy with feedback on each button
    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const textToCopy = btn.getAttribute('data-copy') || '';
        if (!textToCopy) return;

        let copied = false;
        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(textToCopy);
            copied = true;
          } catch {
            copied = false;
          }
        }

        if (!copied) {
          const textArea = document.createElement('textarea');
          textArea.value = textToCopy;
          textArea.style.position = 'fixed';
          textArea.style.left = '-999999px';
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          try {
            document.execCommand('copy');
            copied = true;
          } catch {
            copied = false;
          }
          document.body.removeChild(textArea);
        }

        if (copied) {
          const iconCopy = btn.querySelector('.icon-copy');
          const iconCheck = btn.querySelector('.icon-check');
          const copyLabel = btn.querySelector('.copy-label');

          if (iconCopy) iconCopy.classList.add('hidden');
          if (iconCheck) iconCheck.classList.remove('hidden');
          if (copyLabel) copyLabel.textContent = '¡Copiado!';

          setTimeout(() => {
            if (iconCopy) iconCopy.classList.remove('hidden');
            if (iconCheck) iconCheck.classList.add('hidden');
            if (copyLabel) copyLabel.textContent = 'Copiar';
          }, 2000);
        }
      });
    });
  }

  setupPaymentModal();
  document.addEventListener('astro:after-swap', setupPaymentModal);
</script>
