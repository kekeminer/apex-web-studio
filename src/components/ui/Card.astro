---
interface Props {
  class?: string;
  hover?: boolean;
}
const { class: className = '', hover = true } = Astro.props;
---

<div
  class={`p-6 md:p-8 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] backdrop-blur-sm transition-all duration-300 ${
    hover ? 'hover:bg-[var(--card-hover-bg)] hover:translate-y-[-2px]' : ''
  } ${className}`}
>
  <slot />
</div>
