---
import Badge from '../ui/Badge.astro';
import { ChevronDown } from 'lucide-astro';

const faqs = [
  {
    question: '¿El precio incluye dominio y hosting?',
    answer: 'El desarrollo no incluye el costo del dominio ni del hosting, que se contratan por separado. Podemos asesorarte y gestionar su configuración si lo necesitás.',
  },
  {
    question: '¿Cuánto tarda un proyecto?',
    answer: 'Depende del alcance. Una landing puede estar lista en 5 a 7 días; los proyectos más grandes se entregan con un cronograma acordado.',
  },
  {
    question: '¿Cómo se realiza el pago?',
    answer: 'Trabajamos con un esquema 40-30-30: 40% al iniciar el proyecto, 30% al entregar el diseño y la funcionalidad, y 30% al publicar el sitio en la web. Aceptamos Mercado Pago, transferencia bancaria, criptomoneda y efectivo.',
  },
  {
    question: '¿La consulta inicial tiene costo?',
    answer: 'No, la primera consulta para conocer tu proyecto es sin cargo. El resto de los servicios se presupuesta según el alcance.',
  },
  {
    question: '¿Los sitios se adaptan a celulares?',
    answer: 'Sí, todo lo que desarrollamos es responsive y se adapta a móviles, tablets y escritorio.',
  },
  {
    question: '¿Ofrecen mantenimiento posterior?',
    answer: 'Sí, contamos con planes de mantenimiento mensual en tres niveles: Básico, Pro y Business.',
  },
  {
    question: '¿Puedo pedir cambios después de la entrega?',
    answer: 'Sí, dentro de lo acordado en el presupuesto. Los cambios fuera del alcance se cotizan aparte.',
  },
  {
    question: '¿Trabajan con clientes fuera de Argentina?',
    answer: 'Sí, trabajamos de forma remota con clientes de Argentina y del mundo.',
  },
];
---

<section id="faq" class="py-20 border-t border-[var(--border-color)] relative bg-[var(--bg)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-animate="fade-up" class="text-left max-w-3xl mb-12">
      <Badge class="mb-4">Respuestas Rápidas</Badge>
      <h2 class="font-heading font-bold text-3xl sm:text-5xl text-[var(--text)] tracking-tight mb-4">
        Preguntas Frecuentes
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed">
        Despeja tus dudas sobre metodología, formas de pago, plazos y condiciones de desarrollo antes de iniciar tu proyecto.
      </p>
    </div>

    <!-- Accordion Container (Rounded Borders & 38px-40px Compact Interactive Row) -->
    <div data-animate="fade-up" class="max-w-4xl space-y-3 text-left">
      {
        faqs.map((faq) => (
          <div class="faq-card border border-[var(--border-color)] hover:border-[var(--text)] focus-within:border-[var(--text)] rounded-xl overflow-hidden transition-all duration-200 bg-[var(--card-bg)]">
            <details class="group cursor-pointer">
              <summary class="w-full h-10 py-2 px-4 flex items-center justify-between font-heading font-semibold text-xs sm:text-sm text-[var(--text)] select-none list-none focus:outline-none transition-colors group-hover:bg-[var(--card-hover-bg)]">
                <span>{faq.question}</span>
                <ChevronDown class="w-4 h-4 opacity-70 transition-transform duration-300 group-open:rotate-180 flex-shrink-0 ml-3" />
              </summary>
              <div class="faq-answer px-4 pb-4 pt-3 text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed border-t border-[var(--border-color)] bg-[var(--card-hover-bg)]">
                <p>{faq.answer}</p>
              </div>
            </details>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  details[open] .faq-answer {
    animation: faqExpand 0.25s ease-out forwards;
  }

  @keyframes faqExpand {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details[open] .faq-answer {
      animation: none !important;
    }
  }
</style>
