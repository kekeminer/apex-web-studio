---
import Button from '../ui/Button.astro';
import { ArrowRight } from 'lucide-astro';
---

<section class="relative min-h-[75vh] flex items-center justify-start pt-12 pb-20 overflow-hidden bg-[var(--bg)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Hero Content -->
      <div class="lg:col-span-7 text-left">
        <!-- H1 Headline -->
        <h1
          data-animate="fade-up"
          class="font-heading font-extrabold text-4xl sm:text-6xl lg:text-7xl tracking-tight text-[var(--text)] max-w-4xl leading-[1.1] mb-8"
        >
          Ingeniería Web de Precisión, adaptada a tu bolsillo.
        </h1>

        <!-- Subtitle -->
        <p
          data-animate="fade-up"
          class="text-lg sm:text-xl text-[var(--text-muted)] max-w-3xl leading-relaxed mb-10 font-normal"
        >
          Transformamos la visión de marcas exigentes en plataformas estáticas ultrarrápidas, accesibles y optimizadas para máxima conversión comercial.
        </p>

        <!-- CTAs -->
        <div data-animate="fade-up" class="flex flex-col sm:flex-row items-stretch sm:items-center justify-start gap-4">
          <Button href="#contacto" variant="primary" size="lg" class="w-full sm:w-auto shadow-lg rounded-xl">
            <span>Iniciar Proyecto</span>
            <ArrowRight class="w-5 h-5" />
          </Button>
          <Button href="#servicios" variant="secondary" size="lg" class="w-full sm:w-auto rounded-xl">
            Explorar Servicios
          </Button>
        </div>
      </div>

      <!-- Right Column: Static 3D Code Editor Window (8cm width = 302px by 6cm height = 227px) -->
      <div class="lg:col-span-5 hidden lg:flex justify-center items-center">
        <div
          class="w-[302px] h-[227px] rounded-xl border-2 border-[var(--border-color)] bg-[var(--card-bg)] shadow-2xl p-4 flex flex-col justify-between overflow-hidden relative transition-all duration-300 hover:border-[var(--text)]"
          style="transform: perspective(600px) rotateY(-15deg) rotateX(4deg); transform-style: preserve-3d;"
        >
          <!-- Window Header (Dots + Filename) -->
          <div class="flex items-center gap-1.5 pb-2 border-b border-[var(--border-color)]">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--text)] opacity-40"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--text)] opacity-40"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--text)] opacity-40"></span>
            <span class="text-[10px] font-mono font-medium text-[var(--text-muted)] ml-auto">index.html</span>
          </div>

          <!-- Typewriter Code Content -->
          <div class="my-auto py-1">
            <pre class="font-mono text-[10px] leading-[1.3] text-[var(--text)] overflow-hidden whitespace-pre-wrap break-all select-none"><code id="hero-code-content"></code><span class="animate-pulse font-bold text-[var(--text)]">|</span></pre>
          </div>

          <!-- Footer Bar -->
          <div class="pt-1.5 border-t border-[var(--border-color)] flex items-center justify-between text-[9px] font-mono text-[var(--text-muted)]">
            <span>UTF-8</span>
            <span>HTML5</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupTypewriter() {
    const codeContainer = document.getElementById('hero-code-content');
    if (!codeContainer) return;

    const fullCode = `<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Apex Web Studio</title>
  </head>
  <body>
    <h1>Ingeniería web de precisión</h1>
  </body>
</html>`;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      codeContainer.textContent = fullCode;
      return;
    }

    let charIndex = 0;
    let isDeleting = false;

    function typeLoop() {
      if (!codeContainer) return;

      if (!isDeleting) {
        codeContainer.textContent = fullCode.slice(0, charIndex);
        charIndex++;
        if (charIndex > fullCode.length) {
          isDeleting = true;
          setTimeout(typeLoop, 2200);
          return;
        }
      } else {
        codeContainer.textContent = fullCode.slice(0, charIndex);
        charIndex--;
        if (charIndex < 0) {
          isDeleting = false;
          charIndex = 0;
          setTimeout(typeLoop, 600);
          return;
        }
      }

      const speed = isDeleting ? 20 : 40;
      setTimeout(typeLoop, speed);
    }

    typeLoop();
  }

  setupTypewriter();
  document.addEventListener('astro:after-swap', setupTypewriter);
</script>
