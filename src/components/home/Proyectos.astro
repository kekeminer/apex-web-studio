---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { CheckCircle2 } from 'lucide-astro';

const allProjects = await getCollection('proyectos');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const topProjects = sortedProjects.slice(0, 3);
const bottomProjects = sortedProjects.slice(3, 6);

// Duplicate rows for infinite seamless looping
const topRow = [...topProjects, ...topProjects, ...topProjects];
const bottomRow = [...bottomProjects, ...bottomProjects, ...bottomProjects];
---

<section id="proyectos" class="py-24 border-t border-[var(--border-color)] relative overflow-hidden bg-[var(--bg)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div data-animate="fade-up" class="text-left max-w-3xl">
      <Badge class="mb-4">Portafolio & Casos de Éxito</Badge>
      <h2 class="font-heading font-bold text-3xl sm:text-5xl text-[var(--text)] tracking-tight mb-6">
        Proyectos Recientes Destacados
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed">
        Explora cómo hemos ayudado a empresas líderes a transformar su infraestructura web con diseño de precisión y velocidad extrema.
      </p>
    </div>
  </div>

  <!-- Full-Bleed Marquee Wrappers -->
  <div class="w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] space-y-8 overflow-hidden">
    <!-- Top Row: Marquee Left -->
    <div class="marquee-container flex overflow-hidden">
      <div class="marquee-track-left flex gap-6 px-4">
        {
          topRow.map((project) => (
            <Card class="w-[340px] sm:w-[420px] flex-shrink-0 flex flex-col justify-between overflow-hidden group border border-[var(--border-color)]">
              <div>
                <!-- Duotone Filter Image Container -->
                <div class="relative w-full h-48 mb-5 rounded-xl overflow-hidden border border-[var(--border-color)] bg-[var(--bg)]">
                  <img
                    src={project.data.image}
                    alt={`Captura del proyecto ${project.data.title}`}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 filter grayscale contrast-125 opacity-90 group-hover:opacity-100"
                  />
                  <div class="absolute inset-0 bg-[var(--text)] opacity-10 mix-blend-multiply group-hover:opacity-0 transition-opacity pointer-events-none"></div>
                  <div class="absolute top-3 right-3">
                    <Badge class="bg-[var(--bg)] text-[var(--text)] font-mono text-[10px]">
                      {project.data.category}
                    </Badge>
                  </div>
                </div>

                <span class="text-xs font-mono text-[var(--text-subtle)] uppercase tracking-wider block mb-1">
                  Cliente: {project.data.client}
                </span>
                <h3 class="font-heading font-bold text-lg text-[var(--text)] mb-2">
                  {project.data.title}
                </h3>
                <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-4 line-clamp-2">
                  {project.data.description}
                </p>

                <!-- Results List -->
                <div class="mb-4 space-y-1.5">
                  {project.data.results.map((res) => (
                    <div class="flex items-center gap-2 text-xs font-mono text-[var(--text)]">
                      <CheckCircle2 class="w-3.5 h-3.5 opacity-80 flex-shrink-0" />
                      <span>{res}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Tech Badges -->
              <div class="pt-3 border-t border-[var(--border-color)] flex flex-wrap gap-1.5">
                {project.data.technologies.map((tech) => (
                  <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-[var(--badge-bg)] text-[var(--text-muted)] border border-[var(--border-color)]">
                    {tech}
                  </span>
                ))}
              </div>
            </Card>
          ))
        }
      </div>
    </div>

    <!-- Bottom Row: Marquee Right -->
    <div class="marquee-container flex overflow-hidden">
      <div class="marquee-track-right flex gap-6 px-4">
        {
          bottomRow.map((project) => (
            <Card class="w-[340px] sm:w-[420px] flex-shrink-0 flex flex-col justify-between overflow-hidden group border border-[var(--border-color)]">
              <div>
                <!-- Duotone Filter Image Container -->
                <div class="relative w-full h-48 mb-5 rounded-xl overflow-hidden border border-[var(--border-color)] bg-[var(--bg)]">
                  <img
                    src={project.data.image}
                    alt={`Captura del proyecto ${project.data.title}`}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 filter grayscale contrast-125 opacity-90 group-hover:opacity-100"
                  />
                  <div class="absolute inset-0 bg-[var(--text)] opacity-10 mix-blend-multiply group-hover:opacity-0 transition-opacity pointer-events-none"></div>
                  <div class="absolute top-3 right-3">
                    <Badge class="bg-[var(--bg)] text-[var(--text)] font-mono text-[10px]">
                      {project.data.category}
                    </Badge>
                  </div>
                </div>

                <span class="text-xs font-mono text-[var(--text-subtle)] uppercase tracking-wider block mb-1">
                  Cliente: {project.data.client}
                </span>
                <h3 class="font-heading font-bold text-lg text-[var(--text)] mb-2">
                  {project.data.title}
                </h3>
                <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-4 line-clamp-2">
                  {project.data.description}
                </p>

                <!-- Results List -->
                <div class="mb-4 space-y-1.5">
                  {project.data.results.map((res) => (
                    <div class="flex items-center gap-2 text-xs font-mono text-[var(--text)]">
                      <CheckCircle2 class="w-3.5 h-3.5 opacity-80 flex-shrink-0" />
                      <span>{res}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Tech Badges -->
              <div class="pt-3 border-t border-[var(--border-color)] flex flex-wrap gap-1.5">
                {project.data.technologies.map((tech) => (
                  <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-[var(--badge-bg)] text-[var(--text-muted)] border border-[var(--border-color)]">
                    {tech}
                  </span>
                ))}
              </div>
            </Card>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }

  @keyframes scroll-right {
    0% {
      transform: translateX(-33.333%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .marquee-track-left {
    display: flex;
    width: max-content;
    animation: scroll-left 40s linear infinite;
  }

  .marquee-track-right {
    display: flex;
    width: max-content;
    animation: scroll-right 40s linear infinite;
  }

  .marquee-track-left:hover,
  .marquee-track-right:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-container {
      overflow-x: auto;
    }
    .marquee-track-left,
    .marquee-track-right {
      animation: none !important;
      width: 100% !important;
      flex-wrap: wrap !important;
      transform: none !important;
    }
  }
</style>
