---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { CheckCircle2 } from 'lucide-astro';

const allProjects = await getCollection('proyectos');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<section id="proyectos" class="py-24 border-t border-[var(--border-color)] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-animate="fade-up" class="text-center max-w-3xl mx-auto mb-16">
      <Badge class="mb-4">Portafolio & Casos de Éxito</Badge>
      <h2 class="font-heading font-bold text-3xl sm:text-5xl text-[var(--text)] tracking-tight mb-6">
        Proyectos Recientes Destacados
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed">
        Explora cómo hemos ayudado a empresas líderes a transformar su infraestructura web con diseño de precisión y velocidad extrema.
      </p>
    </div>

    <!-- Projects Grid -->
    <div data-animate="stagger" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projects.map((project) => (
          <Card class="flex flex-col justify-between overflow-hidden group">
            <div>
              <!-- Duotone Filter Image Container strictly restricted to #0A1633 and #FFFFFF opacities -->
              <div class="relative w-full h-52 mb-6 rounded-xl overflow-hidden border border-[var(--border-color)] bg-[var(--bg)]">
                <img
                  src={project.data.image}
                  alt={`Captura del proyecto ${project.data.title}`}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 filter grayscale contrast-125 opacity-90 group-hover:opacity-100"
                />
                <!-- Duotone overlay layer -->
                <div class="absolute inset-0 bg-[var(--text)] opacity-10 mix-blend-multiply group-hover:opacity-0 transition-opacity pointer-events-none"></div>
                <div class="absolute top-3 right-3">
                  <Badge class="bg-[var(--bg)] text-[var(--text)] font-mono text-[10px]">
                    {project.data.category}
                  </Badge>
                </div>
              </div>

              <span class="text-xs font-mono text-[var(--text-subtle)] uppercase tracking-wider block mb-1">
                Cliente: {project.data.client}
              </span>
              <h3 class="font-heading font-bold text-xl text-[var(--text)] mb-3">
                {project.data.title}
              </h3>
              <p class="text-sm text-[var(--text-muted)] leading-relaxed mb-6">
                {project.data.description}
              </p>

              <!-- Results List -->
              <div class="mb-6 space-y-2">
                {project.data.results.map((res) => (
                  <div class="flex items-center gap-2 text-xs font-mono text-[var(--text)]">
                    <CheckCircle2 class="w-3.5 h-3.5 opacity-80" />
                    <span>{res}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Tech Badges -->
            <div class="pt-4 border-t border-[var(--border-color)] flex flex-wrap gap-1.5">
              {project.data.technologies.map((tech) => (
                <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-[var(--badge-bg)] text-[var(--text-muted)] border border-[var(--border-color)]">
                  {tech}
                </span>
              ))}
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>
