---
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import { ShieldCheck, Target, Award, Users, Compass } from 'lucide-astro';

const states = [
  {
    type: 'logo',
    title: 'Apex Web Studio',
    subtitle: 'Arquitectura & Desarrollo Web Senior',
  },
  {
    type: 'content',
    title: 'Filosofía Cero Deuda',
    description: 'Escribimos código limpio, tipado y documentado con estándares de producción desde la primera entrega.',
    icon: Target,
  },
  {
    type: 'content',
    title: 'Rendimiento Incomprometible',
    description: 'Cada milisegundo cuenta. Optimizamos activos y renderizado para asegurar métricas en verde.',
    icon: Award,
  },
  {
    type: 'content',
    title: 'Accesibilidad Universal',
    description: 'Diseñamos interfaces inclusivas que cumplen estrictamente con la normativa WCAG 2.1 Nivel AA.',
    icon: Users,
  },
  {
    type: 'content',
    title: 'Acompañamiento Estratégico',
    description: 'Trabajamos en estrecha colaboración para alinear el desarrollo técnico con tus objetivos de negocio.',
    icon: Compass,
  },
];
---

<section id="nosotros" class="py-24 border-t border-[var(--border-color)] relative bg-[var(--bg)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left Column: Company Description -->
      <div data-animate="fade-up" class="text-left">
        <Badge class="mb-4 gap-2">
          <ShieldCheck class="w-3.5 h-3.5" />
          <span>Desarrollo bajo la normativa WCAG 2.1 Nivel AA</span>
        </Badge>
        
        <h2 class="font-heading font-bold text-3xl sm:text-5xl text-[var(--text)] tracking-tight mb-6">
          Apex Web Studio
        </h2>

        <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed mb-6">
          Apex Web Studio es un estudio de desarrollo digital full stack con base en la provincia de Entre Ríos, Argentina. Construimos experiencias web de alto rendimiento que combinan diseño de vanguardia, ingeniería sólida y foco en los resultados de cada negocio.
        </p>
        <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed">
          Cada proyecto que entregamos se desarrolla bajo la normativa de accesibilidad WCAG 2.1 Nivel AA, garantizando productos digitales utilizables por todas las personas. Trabajamos con clientes de Argentina y del mundo, ofreciendo soluciones a medida de cada necesidad.
        </p>
      </div>

      <!-- Right Column: Single 5-Second Rotating Card -->
      <div data-animate="fade-up" class="w-full flex justify-center">
        <Card hover={false} class="w-full max-w-md min-h-[280px] flex flex-col justify-center items-center text-center p-8 border-2 border-[var(--border-color)] bg-[var(--card-bg)] relative overflow-hidden transition-all duration-500">
          
          <!-- State 0: Apex Logo -->
          <div id="rotator-state-0" class="rotator-item flex flex-col items-center justify-center transition-opacity duration-500 opacity-100">
            <img src="/logo.webp" alt="Apex Web Studio Logo" width="80" height="80" class="h-20 w-auto object-contain mb-4" loading="lazy" decoding="async" />
            <h3 class="font-heading font-bold text-xl text-[var(--text)]">
              Apex Web Studio
            </h3>
            <span class="text-xs font-mono text-[var(--text-subtle)] mt-1 uppercase tracking-wider">
              Entre Ríos, Argentina
            </span>
          </div>

          <!-- State 1: Filosofía Cero Deuda -->
          <div id="rotator-state-1" class="rotator-item flex flex-col items-center justify-center transition-opacity duration-500 opacity-0 absolute inset-0 p-8 pointer-events-none">
            <div class="w-12 h-12 rounded-xl border border-[var(--border-color)] bg-[var(--badge-bg)] flex items-center justify-center text-[var(--text)] mb-4">
              <Target class="w-6 h-6" />
            </div>
            <h3 class="font-heading font-bold text-xl text-[var(--text)] mb-3">
              Filosofía Cero Deuda
            </h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">
              Escribimos código limpio, tipado y documentado con estándares de producción desde la primera entrega.
            </p>
          </div>

          <!-- State 2: Rendimiento Incomprometible -->
          <div id="rotator-state-2" class="rotator-item flex flex-col items-center justify-center transition-opacity duration-500 opacity-0 absolute inset-0 p-8 pointer-events-none">
            <div class="w-12 h-12 rounded-xl border border-[var(--border-color)] bg-[var(--badge-bg)] flex items-center justify-center text-[var(--text)] mb-4">
              <Award class="w-6 h-6" />
            </div>
            <h3 class="font-heading font-bold text-xl text-[var(--text)] mb-3">
              Rendimiento Incomprometible
            </h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">
              Cada milisegundo cuenta. Optimizamos activos y renderizado para asegurar métricas en verde.
            </p>
          </div>

          <!-- State 3: Accesibilidad Universal -->
          <div id="rotator-state-3" class="rotator-item flex flex-col items-center justify-center transition-opacity duration-500 opacity-0 absolute inset-0 p-8 pointer-events-none">
            <div class="w-12 h-12 rounded-xl border border-[var(--border-color)] bg-[var(--badge-bg)] flex items-center justify-center text-[var(--text)] mb-4">
              <Users class="w-6 h-6" />
            </div>
            <h3 class="font-heading font-bold text-xl text-[var(--text)] mb-3">
              Accesibilidad Universal
            </h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">
              Diseñamos interfaces inclusivas que cumplen estrictamente con la normativa WCAG 2.1 Nivel AA.
            </p>
          </div>

          <!-- State 4: Acompañamiento Estratégico -->
          <div id="rotator-state-4" class="rotator-item flex flex-col items-center justify-center transition-opacity duration-500 opacity-0 absolute inset-0 p-8 pointer-events-none">
            <div class="w-12 h-12 rounded-xl border border-[var(--border-color)] bg-[var(--badge-bg)] flex items-center justify-center text-[var(--text)] mb-4">
              <Compass class="w-6 h-6" />
            </div>
            <h3 class="font-heading font-bold text-xl text-[var(--text)] mb-3">
              Acompañamiento Estratégico
            </h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">
              Trabajamos en estrecha colaboración para alinear el desarrollo técnico con tus objetivos de negocio.
            </p>
          </div>

          <!-- Pagination Indicators -->
          <div class="absolute bottom-4 flex items-center gap-1.5 z-10">
            {states.map((_, idx) => (
              <span
                id={`rotator-dot-${idx}`}
                class={`w-2 h-2 rounded-full transition-all duration-300 ${
                  idx === 0 ? 'bg-[var(--text)] w-5' : 'bg-[var(--border-color)]'
                }`}
              ></span>
            ))}
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>

<script>
  function setupNosotrosRotator() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    let currentState = 0;
    const totalStates = 5;

    const interval = setInterval(() => {
      const prevItem = document.getElementById(`rotator-state-${currentState}`);
      const prevDot = document.getElementById(`rotator-dot-${currentState}`);

      currentState = (currentState + 1) % totalStates;

      const nextItem = document.getElementById(`rotator-state-${currentState}`);
      const nextDot = document.getElementById(`rotator-dot-${currentState}`);

      if (prevItem && nextItem) {
        prevItem.classList.remove('opacity-100');
        prevItem.classList.add('opacity-0', 'pointer-events-none');

        nextItem.classList.remove('opacity-0', 'pointer-events-none');
        nextItem.classList.add('opacity-100');
      }

      if (prevDot && nextDot) {
        prevDot.classList.remove('bg-[var(--text)]', 'w-5');
        prevDot.classList.add('bg-[var(--border-color)]', 'w-2');

        nextDot.classList.remove('bg-[var(--border-color)]', 'w-2');
        nextDot.classList.add('bg-[var(--text)]', 'w-5');
      }
    }, 5000);

    return () => clearInterval(interval);
  }

  setupNosotrosRotator();
  document.addEventListener('astro:after-swap', setupNosotrosRotator);
</script>
