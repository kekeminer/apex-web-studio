---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { Layout, Server, Cpu, ShieldCheck } from 'lucide-astro';

const stackCategories = [
  {
    title: 'Frontend',
    icon: Layout,
    description: 'Interfaces interactivas, ultrarrápidas y accesibles.',
    items: ['Astro 5', 'React 19', 'Next.js', 'TypeScript', 'Tailwind CSS v4', 'GSAP', 'Lenis', 'HTML5 / SVG', 'Vite'],
  },
  {
    title: 'Backend',
    icon: Server,
    description: 'Arquitectura de servidores, bases de datos y gestión de APIs.',
    items: ['Node.js', 'Express', 'Supabase', 'PostgreSQL', 'MongoDB', 'Redis', 'APIs REST & GraphQL', 'Serverless Functions'],
  },
  {
    title: 'DevOps & Despliegue',
    icon: Cpu,
    description: 'Infraestructura global, CDN, CI/CD y despliegues automatizados.',
    items: ['Git', 'GitHub', 'GitHub Actions', 'Docker', 'Vercel', 'Netlify', 'Cloudflare Pages & Workers', 'AWS S3 / CloudFront'],
  },
  {
    title: 'Calidad & Rendimiento',
    icon: ShieldCheck,
    description: 'Estándares de código estricto, seguridad y rendimiento continuo.',
    items: ['ESLint', 'Prettier', 'Lighthouse 98+', 'WCAG 2.1 AA', 'Auditorías de Seguridad', 'Pentesting & Hardening', 'Core Web Vitals Monitoreo', 'Security Headers'],
  },
];
---

<section id="stack" class="py-24 border-t border-[var(--border-color)] relative bg-[var(--bg)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-animate="fade-up" class="text-left max-w-4xl mb-16">
      <Badge class="mb-4">Ecosistema & Herramientas</Badge>
      <h2 class="font-heading font-bold text-3xl sm:text-5xl text-[var(--text)] tracking-tight mb-4">
        Stack Tecnológico Full-Stack Senior
      </h2>
      <p class="text-base sm:text-lg font-medium text-[var(--text)] leading-relaxed mb-4">
        Optimizamos tu activo digital bajo estándares omnicanal: SEO para buscadores tradicionales, AEO (Answer Engine Optimization) para asistentes de voz y GEO (Generative Engine Optimization) para motores de IA conversacional como ChatGPT, Perplexity y AI Overviews.
      </p>
      <p class="text-sm sm:text-base text-[var(--text-muted)] leading-relaxed">
        Seleccionamos con rigor arquitectónico cada tecnología de nuestra pila para garantizar máxima velocidad de respuesta, seguridad incomprometible y mantenibilidad a largo plazo.
      </p>
    </div>

    <!-- Category Grid -->
    <div data-animate="stagger" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        stackCategories.map((category) => {
          const IconComp = category.icon;
          return (
            <Card class="flex flex-col justify-between p-6">
              <div>
                <div class="w-10 h-10 rounded-lg border border-[var(--border-color)] bg-[var(--badge-bg)] flex items-center justify-center text-[var(--text)] mb-4">
                  <IconComp class="w-5 h-5" />
                </div>
                <h3 class="font-heading font-bold text-xl text-[var(--text)] mb-2">
                  {category.title}
                </h3>
                <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-6">
                  {category.description}
                </p>

                <div class="space-y-2 pt-4 border-t border-[var(--border-color)]">
                  {category.items.map((item) => (
                    <div class="flex items-center gap-2 text-xs font-mono text-[var(--text)]">
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--text)] opacity-60"></span>
                      <span>{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </Card>
          );
        })
      }
    </div>
  </div>
</section>
