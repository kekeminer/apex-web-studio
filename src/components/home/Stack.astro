---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { Layout, Server, Cpu, ShieldCheck } from 'lucide-astro';

const stackCategories = [
  {
    title: 'Frontend',
    icon: Layout,
    description: 'Interfaces interactivas, ultrarrápidas y accesibles.',
    items: ['Astro', 'React', 'Next.js', 'TypeScript', 'Tailwind CSS', 'GSAP'],
  },
  {
    title: 'Backend',
    icon: Server,
    description: 'Arquitectura de servidores, APIs y gestión de datos.',
    items: ['Node.js', 'Express', 'PostgreSQL', 'MongoDB', 'APIs REST', 'GraphQL'],
  },
  {
    title: 'DevOps & Despliegue',
    icon: Cpu,
    description: 'Infraestructura global, CI/CD y control de versiones.',
    items: ['Git', 'GitHub', 'GitHub Actions', 'Docker', 'Vercel'],
  },
  {
    title: 'Calidad & Rendimiento',
    icon: ShieldCheck,
    description: 'Estándares estrictos de código, auditoría y accesibilidad.',
    items: ['ESLint', 'Prettier', 'Lighthouse', 'WCAG 2.1 AA'],
  },
];
---

<section id="stack" class="py-24 border-t border-[var(--border-color)] relative bg-[var(--bg)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-animate="fade-up" class="text-left max-w-4xl mb-16">
      <Badge class="mb-4">Ecosistema & Herramientas</Badge>
      <h2 class="font-heading font-bold text-3xl sm:text-5xl text-[var(--text)] tracking-tight mb-4">
        Stack Tecnológico Full-Stack Senior
      </h2>
      <p class="text-base sm:text-lg font-medium text-[var(--text)] leading-relaxed mb-4">
        SEO para buscadores clásicos, AEO para respuestas directas y búsqueda por voz, y GEO para motores de inteligencia artificial como ChatGPT, Perplexity y AI Overviews.
      </p>
      <p class="text-sm sm:text-base text-[var(--text-muted)] leading-relaxed">
        Seleccionamos rigurosamente cada herramienta del ecosistema web para garantizar la velocidad, mantenibilidad e invariabilidad de tu sitio.
      </p>
    </div>

    <!-- Category Grid -->
    <div data-animate="stagger" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        stackCategories.map((category) => {
          const IconComp = category.icon;
          return (
            <Card class="flex flex-col justify-between p-6">
              <div>
                <div class="w-10 h-10 rounded-lg border border-[var(--border-color)] bg-[var(--badge-bg)] flex items-center justify-center text-[var(--text)] mb-4">
                  <IconComp class="w-5 h-5" />
                </div>
                <h3 class="font-heading font-bold text-xl text-[var(--text)] mb-2">
                  {category.title}
                </h3>
                <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-6">
                  {category.description}
                </p>

                <div class="space-y-2 pt-4 border-t border-[var(--border-color)]">
                  {category.items.map((item) => (
                    <div class="flex items-center gap-2 text-xs font-mono text-[var(--text)]">
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--text)] opacity-60"></span>
                      <span>{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </Card>
          );
        })
      }
    </div>
  </div>
</section>
