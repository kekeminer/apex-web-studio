---
import FormField from '../ui/FormField.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import { Send, CheckCircle, AlertCircle, Loader2 } from 'lucide-astro';

const serviceOptions = [
  { value: 'desarrollo-web', label: 'Desarrollo Web High-End' },
  { value: 'tiendas-ecommerce', label: 'Tiendas E-commerce' },
  { value: 'aplicaciones-web', label: 'Aplicaciones Web Custom' },
  { value: 'seo-y-rendimiento', label: 'SEO Técnico & Rendimiento' },
  { value: 'mantenimiento-y-soporte', label: 'Mantenimiento & Soporte' },
];
---

<section id="contacto" class="py-24 border-t border-[var(--border-color)] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-animate="fade-up" class="text-center max-w-3xl mx-auto mb-16">
      <Badge class="mb-4">Contacto & Diagnóstico</Badge>
      <h2 class="font-heading font-bold text-3xl sm:text-5xl text-[var(--text)] tracking-tight mb-6">
        Inicia tu Proyecto con Apex Web Studio
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed">
        Solicita una evaluación técnica gratuita de tu proyecto. Responderemos en menos de 24 horas hábiles.
      </p>
    </div>

    <div class="max-w-2xl mx-auto">
      <Card data-animate="fade-up" hover={false}>
        <form
          id="contact-form"
          action="https://formspree.io/f/xvkpwaov"
          method="POST"
          novalidate
          class="flex flex-col gap-6"
        >
          <!-- Honeypot oculto antispam -->
          <div class="hidden" aria-hidden="true">
            <label for="gotcha">No llenar este campo:</label>
            <input type="text" id="gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <FormField
              label="Nombre Completo"
              name="name"
              type="text"
              required={true}
              placeholder="Ej. Sofia Martínez"
            />
            <FormField
              label="Correo Electrónico"
              name="email"
              type="email"
              required={true}
              placeholder="sofia@empresa.com"
            />
          </div>

          <FormField
            label="Servicio de Interés"
            name="service"
            type="select"
            required={true}
            options={serviceOptions}
            placeholder="Selecciona el servicio a consultar"
          />

          <FormField
            label="Detalles del Proyecto / Mensaje"
            name="message"
            type="textarea"
            required={true}
            rows={5}
            placeholder="Describe tus metas, alcance estimado o dudas técnicas..."
          />

          <FormField
            label="Acepto la política de privacidad y el procesamiento de mis datos para esta consulta."
            name="privacy"
            type="checkbox"
            required={true}
          />

          <!-- Form Status Feedback Messages -->
          <div id="form-status-success" class="hidden p-4 rounded-xl border border-[var(--border-color)] bg-[var(--badge-bg)] text-[var(--text)] flex items-center gap-3">
            <CheckCircle class="w-5 h-5 flex-shrink-0" />
            <span class="text-sm font-medium">¡Mensaje enviado con éxito! Nos pondremos en contacto contigo a la brevedad.</span>
          </div>

          <div id="form-status-error" class="hidden p-4 rounded-xl border border-[var(--border-color)] bg-[var(--card-hover-bg)] text-[var(--text)] flex items-center gap-3" role="alert">
            <AlertCircle class="w-5 h-5 flex-shrink-0" />
            <span id="form-error-text" class="text-sm font-medium">Ocurrió un error al enviar el formulario. Por favor, revisa los campos e intenta nuevamente.</span>
          </div>

          <!-- Submit Button -->
          <Button type="submit" id="submit-btn" variant="primary" size="lg" class="w-full">
            <span id="btn-text" class="flex items-center gap-2">
              <span>Enviar Consulta Gratuita</span>
              <Send class="w-4 h-4" />
            </span>
            <span id="btn-spinner" class="hidden flex items-center gap-2">
              <Loader2 class="w-5 h-5 animate-spin" />
              <span>Enviando mensaje...</span>
            </span>
          </Button>
        </form>
      </Card>
    </div>
  </div>
</section>

<script>
  function setupForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const statusSuccess = document.getElementById('form-status-success');
    const statusError = document.getElementById('form-status-error');
    const errorText = document.getElementById('form-error-text');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Reset feedback
      statusSuccess?.classList.add('hidden');
      statusError?.classList.add('hidden');

      // Client-side validation
      const name = (form.querySelector('[name="name"]') as HTMLInputElement).value.trim();
      const email = (form.querySelector('[name="email"]') as HTMLInputElement).value.trim();
      const service = (form.querySelector('[name="service"]') as HTMLSelectElement).value;
      const message = (form.querySelector('[name="message"]') as HTMLTextAreaElement).value.trim();
      const privacy = (form.querySelector('[name="privacy"]') as HTMLInputElement).checked;

      let valid = true;
      let errorMsg = '';

      if (!name || name.length < 2) {
        valid = false;
        errorMsg = 'Por favor ingresa un nombre válido (mínimo 2 caracteres).';
      } else if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        valid = false;
        errorMsg = 'Por favor ingresa un correo electrónico válido.';
      } else if (!service) {
        valid = false;
        errorMsg = 'Por favor selecciona un servicio.';
      } else if (!message || message.length < 10) {
        valid = false;
        errorMsg = 'El mensaje debe contener al menos 10 caracteres.';
      } else if (!privacy) {
        valid = false;
        errorMsg = 'Debes aceptar la política de privacidad.';
      }

      if (!valid) {
        if (statusError && errorText) {
          errorText.textContent = errorMsg;
          statusError.classList.remove('hidden');
        }
        return;
      }

      // Loading state
      if (submitBtn) submitBtn.disabled = true;
      btnText?.classList.add('hidden');
      btnSpinner?.classList.remove('hidden');

      try {
        const formData = new FormData(form);
        const response = await fetch('https://formspree.io/f/xvkpwaov', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          statusSuccess?.classList.remove('hidden');
          form.reset();
        } else {
          const data = await response.json();
          throw new Error(data.error || 'Error al procesar el envío.');
        }
      } catch (err) {
        if (statusError && errorText) {
          errorText.textContent = err instanceof Error ? err.message : 'Error inesperado al enviar el formulario.';
          statusError.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        btnText?.classList.remove('hidden');
        btnSpinner?.classList.add('hidden');
      }
    });
  }

  setupForm();
  document.addEventListener('astro:after-swap', setupForm);
</script>
